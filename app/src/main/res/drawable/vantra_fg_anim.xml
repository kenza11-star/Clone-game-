<?xml version="1.0" encoding="utf-8"?>
<!-- animated vantra foreground: the play shape breathes, the three sound waves ripple outward -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/vantra_fg_static">
    <target android:name="shape">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:duration="1800" android:valueFrom="1" android:valueTo="1.05" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:duration="1800" android:valueFrom="1" android:valueTo="1.05" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="wave1">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:duration="1600" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="restart" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="wave2">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:duration="1600" android:startOffset="200" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="restart" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="wave3">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:duration="1600" android:startOffset="400" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:repeatCount="-1" android:repeatMode="restart" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
